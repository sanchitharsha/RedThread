# LLM provider: "gemini" or "openai"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# API keys (set the one matching your provider)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Set to 1 to run against stubs instead of real agent/matching
USE_STUBS=0

# Set to 1 to skip real network calls (CPSC API etc.)
OFFLINE=0

# Sandbox shop URL (M4's local server)
SHOP_URL=http://localhost:8001

# Domain allowlist for the browser agent (comma-separated)
ALLOW_DOMAINS=localhost

# Backend
BACKEND_PORT=8000
FRONTEND_PORT=5173
